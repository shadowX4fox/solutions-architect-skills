{
  "// MARKETPLACE REGISTRATION": "Register the shadowx4fox marketplace to install plugins",
  "extraKnownMarketplaces": {
    "shadowx4fox-solution-architect-marketplace": {
      "source": {
        "source": "github",
        "repo": "shadowX4fox/solutions-architect-skills"
      }
    }
  },

  "// PLUGIN INSTALLATION": "Enable the solutions-architect-skills plugin",
  "enabledPlugins": {
    "sa-skills@shadowx4fox-solution-architect-marketplace": true,
    "sa-records@shadowx4fox-solution-architect-marketplace": true,
    "sa-requirements@shadowx4fox-solution-architect-marketplace": true,
    "sa-analysis@shadowx4fox-solution-architect-marketplace": true,
    "sa-delivery@shadowx4fox-solution-architect-marketplace": true,
    "sa-visualization@shadowx4fox-solution-architect-marketplace": true
  },

  "// PERMISSIONS": "Required for the plugin's sub-agents — plugin agents cannot use permissionMode frontmatter",
  "// BASH": "bun (covers ALL shell needs since v3.21.0 — date/mkdir/rm replaced by scripts/{today,ensure-dir,remove-glob}.ts; OS-agnostic, no POSIX-shell dependency). git clone + git -C .cache/sa-skills/adr-catalog: architecture-definition-record Workflows 6 and 9 clone the institutional ADR catalog from its git URL into that fixed project-local path and refresh it there; the path is fixed precisely so the grant stays this narrow — no other git invocation is pre-granted.",
  "// FILE ACCESS": "Read/Write .cache/sa-skills/** (project-local staging — handoff payloads, icepanel JSON; OS-agnostic, no /tmp dependency), Read/Write visualizations/* (architecture-command-center scene JSON + HTML)",
  "// PLUGIN READ": "Skills read templates and guides from the plugin marketplace cache",
  "// AGENTS": "Grants use the form <plugin>:<role>:<agent>. Without a grant, every sub-agent call prompts: the section and segment writers, the ADR writer, the Layer 2 principle reviewer, the worksheet judge (each judge worksheet), the acceptance-test writer, the analysis agent and the handoff and export generators.",
  "permissions": {
    "allow": [
      "Bash(bun *)",
      "Bash(bunx hyperframes*)",
      "Bash(rg *)",
      "Bash(git clone *)",
      "Bash(git -C .cache/sa-skills/adr-catalog *)",
      "Read(~/.claude/plugins/marketplaces/shadowx4fox-solution-architect-marketplace/**)",
      "Read(~/.claude/plugins/cache/shadowx4fox-solution-architect-marketplace/**)",
      "Read(**/skills/architecture-dev-handoff/SKILL.md)",
      "Read(.cache/sa-skills/**)",
      "Edit(.cache/sa-skills/**)",
      "Agent(sa-analysis:reviewers:architecture-analysis-agent)",
      "Agent(sa-skills:reviewers:principle-quality-reviewer)",
      "Agent(sa-skills:reviewers:worksheet-judge)",
      "Agent(sa-requirements:generators:acceptance-test-writer)",
      "Agent(sa-delivery:generators:ekonte-generator)",
      "Agent(sa-delivery:generators:settei-generator)",
      "Agent(sa-delivery:generators:seam-generator)",
      "Agent(sa-skills:generators:segment-runner)",
      "Agent(sa-records:generators:adr-writer)",
      "Agent(sa-delivery:generators:cutsheet-generator)",
      "Agent(sa-delivery:generators:handoff-asset-generator)",
      "Agent(sa-delivery:generators:docs-export-generator)",
      "Edit(exports/*)",
      "Read(exports/*)",
      "Edit(analysis/*)",
      "Read(analysis/*)",
      "Edit(visualizations/*)",
      "Read(visualizations/*)",
      "Edit(visualizations/architecture-video/**)",
      "Read(visualizations/architecture-video/**)",
      "Edit(handoffs/**)",
      "Read(handoffs/**)",
      "Edit(handoffs/.manifest.json)",
      "Read(handoffs/.manifest.json)",
      "Edit(BIAN_ALIGNMENT.md)",
      "Read(BIAN_ALIGNMENT.md)",
      "Edit(CAPABILITY_ALIGNMENT.md)",
      "Read(CAPABILITY_ALIGNMENT.md)",
      "WebSearch"
    ]
  },

  "// HOOKS — 8.100.1+: the routing hook is declared by the plugin": "sa-skills ships hooks/hooks.json: a UserPromptSubmit hook that runs ${CLAUDE_PLUGIN_ROOT}/hooks/route-architecture-docs.sh, which Claude Code resolves to the installed version on every load. When the project root contains ARCHITECTURE.md, a prompt the user typed gets the routing context; elsewhere it prints nothing. No hook belongs in this file: /setup removes any sa-skills routing hook it finds here (the absolute cache paths it wrote up to 8.100.0 went stale on every plugin update) — except on Windows without Git Bash, where hooks run in PowerShell and /setup writes the .ps1 wrapper by the marketplace clone's path.",

  "// USAGE NOTES": [
    "1. Copy this file to your project: cp .claude/settings.json.example /path/to/your/project/.claude/settings.json",
    "2. Remove the comment fields (lines starting with '//')",
    "3. Restart Claude Code to load the marketplace and plugin",
    "4. Verify installation: /plugin list"
  ]
}
