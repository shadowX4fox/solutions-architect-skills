# Release artifacts — everything scripts/build-release.sh writes into release/.
# The checksum was not covered here, which is how a v1.0.0 .sha256 for a ZIP that
# no longer exists stayed committed for four major versions.
*.zip
*.tar.gz
*.sha256

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/

# Bun
node_modules/
bun.lockb

# Build output
dist/
*.tsbuildinfo

# Node/npm logs (legacy)
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.temp
.cache/

# Stale backup files
*.backup
*.bak
*.old

# Test temp artifacts
**/tests/.temp/
# claim-sweep: a real claim names a project's components and files — it stays with that project; only the synthetic example ships
tools/claim-sweep/claims/*.claim.json
!tools/claim-sweep/claims/example-*.claim.json

# written by Claude Code when it loads the sa-ux mods (editor types), never committed
plugins/sa-ux/.claude-plugin/types/

# check-generic.ts: the maintainer's reference projects, one path per line — never committed
.sa-reference-projects
