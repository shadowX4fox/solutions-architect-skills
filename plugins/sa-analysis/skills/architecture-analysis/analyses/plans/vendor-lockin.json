      ],
      "omitWhenEmpty": false,
      "htmlOmit": false,
      "note": "notable L3 items only, never every portable component"
    },
    {
      "key": "Exit Cost Ranking",
      "level": 2,
      "title": {
        "en": "Exit Cost Ranking",
        "es": "Ranking de Costo de Salida"
      },
      "kind": "table",
      "columns": [
        "#",
        "Component",
        "Vendor",
        "Exit Cost",
        "Blocking Factor"
      ],
      "id": "^L[12]-\\d{2,3}$",
      "omitWhenEmpty": false,
      "htmlOmit": false,
      "note": "every L1 + L2 item sorted by exit cost descending, keyed by its existing id — never renumbered",
      "repeatsIds": true
    },
    {
      "key": "Vendor Lock-in Heat Map",
      "level": 2,
      "title": {
        "en": "Vendor Lock-in Heat Map",
        "es": "Mapa de Calor de Dependencia de Proveedor"
      },
      "kind": "heatmap",
      "axes": {
        "x": {
          "label": "STRATEGIC IMPORTANCE",
          "lo": "LOW",
          "hi": "HIGH",
          "n": 3
        },
        "y": {
          "label": "LOCK SEVERITY",
          "lo": "LOW (L3)",
          "hi": "HIGH (L1)",
          "n": 3
        }
      },
      "omitWhenEmpty": false,
      "htmlOmit": true,
      "note": "one entry per L-id: y = lock severity (3 = L1), x = strategic importance (critical user-facing path = HIGH)"
