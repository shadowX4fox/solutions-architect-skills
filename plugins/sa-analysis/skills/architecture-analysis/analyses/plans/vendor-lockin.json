      "level": 2,
      "title": {
        "en": "Vendor Concentration",
        "es": "Concentración por Proveedor"
      },
      "kind": "inventory",
      "columns": [
        "Vendor",
        "Component Count",
        "% of Architecture",
        "Lock Tier Distribution"
      ],
      "omitWhenEmpty": false,
      "htmlOmit": false,
      "note": "one row per vendor over every classified component; Lock Tier Distribution as \"3 L1, 2 L2, 1 L3\"; a vendor at ≥ 60 % is HIGH CONCENTRATION RISK"
    },
    {
      "key": "Locked Capabilities",
      "level": 2,
      "title": {
        "en": "Locked Capabilities (L1)",
        "es": "Capacidades Bloqueadas (L1)"
      },
      "kind": "table",
      "columns": [
        "#",
        "Component / Capability",
        "Vendor",
        "Proprietary Surface",
        "Exit Path",
        "Exit Cost"
      ],
      "id": "^L1-\\d{2,3}$",
      "omitWhenEmpty": false,
      "htmlOmit": false,
      "note": "L1 items, L1-01 … sequential; Exit Path = alternative standard or competitor, \"None identified\" if absent; Exit Cost = High / Medium / Low"
    },
    {
      "key": "Lock-prone Capabilities",
      "level": 2,
      "title": {
        "en": "Lock-prone Capabilities (L2)",
        "es": "Capacidades Propensas al Bloqueo (L2)"
      },
      "kind": "table",
      "columns": [
        "#",
        "Component / Capability",
        "Vendor",
        "Open Standard Used",
        "Vendor Extension",
        "Migration Risk"
      ],
      "id": "^L2-\\d{2,3}$",
      "omitWhenEmpty": false,
      "htmlOmit": false,
      "note": "L2 items, L2-01 … sequential; Migration Risk = High / Medium / Low"
    },
    {
      "key": "Portable Components",
      "level": 2,
      "title": {
        "en": "Portable Components (L3)",
        "es": "Componentes Portables (L3)"
