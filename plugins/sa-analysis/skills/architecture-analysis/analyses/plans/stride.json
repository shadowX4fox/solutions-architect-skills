        "Trust Boundary",
        "STRIDE Category",
        "Threat Description",
        "Recommended Mitigation",
        "ADR Reference"
      ],
      "id": "^T\\d{1,3}-[STRIDE]$",
      "omitWhenEmpty": false,
      "htmlOmit": false,
      "note": "every High-severity finding of the matrix, ordered by boundary criticality — the same id, never renumbered",
      "repeatsIds": true
