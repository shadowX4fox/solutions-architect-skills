        "#",
        "Threat",
        "Category",
        "Severity",
        "Status",
        "Control / Gap"
      ],
      "id": "^T\\d{1,3}-[STRIDE]$",
      "omitWhenEmpty": false,
      "htmlOmit": false,
      "note": "one group per boundary (id TB-nn, title \"TB-nn — Name\"), six rows S T R I D E; a ⚠️ Finding row carries T<n>-<letter> with n running across all boundaries in reading order; a ✅ Pass row carries — as its id"
    },
    {
      "key": "High-Priority Threats",
      "level": 2,
      "title": {
        "en": "High-Priority Threats",
        "es": "Amenazas de Alta Prioridad"
