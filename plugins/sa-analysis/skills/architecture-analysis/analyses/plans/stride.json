    {
      "key": "Trust Boundary Inventory",
      "level": 2,
      "title": {
        "en": "Trust Boundary Inventory",
        "es": "Inventario de Fronteras de Confianza"
      },
      "kind": "table",
      "columns": [
        "ID",
        "Name",
        "From Zone",
        "To Zone",
        "Auth Mechanism",
        "Data Classification",
        "Source"
